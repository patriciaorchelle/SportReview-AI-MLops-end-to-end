{
  "__inputs": [],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Dashboard de monitoring en temps réel pour l'API SportReview AI. Montre les requêtes, la latence, la distribution des prédictions, et la confiance du modèle.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [

    {
      "id": 1,
      "title": "Total Requêtes API",
      "description": "Nombre total de requêtes reçues par l'API depuis le démarrage. Inclut /predict, /predict/batch, /health, etc.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 100 },
              { "color": "yellow", "value": 1000 }
            ]
          },
          "unit": "short",
          "mappings": []
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(sportreview_requests_total)",
          "legendFormat": "Total requêtes",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "title": "Latence Moyenne (p95)",
      "description": "Le 95ème percentile de la latence = 95% des requêtes répondent en moins de X ms. Un bon objectif est < 200ms.",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": "Prometheus",
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "s",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(sportreview_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 latence",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "title": "Taux d'Erreurs",
      "description": "Nombre total d'erreurs API (exceptions, timeouts, 422, 500). Un taux élevé indique un problème avec le modèle ou les données.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": "Prometheus",
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(sportreview_errors_total) or vector(0)",
          "legendFormat": "Erreurs",
          "refId": "A"
        }
      ]
    },

    {
      "id": 4,
      "title": "Prédictions Low Confidence",
      "description": "Nombre de prédictions avec score de confiance < 60%. Un nombre élevé peut indiquer que le modèle rencontre des types d'avis non vus en entraînement (drift).",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(sportreview_low_confidence_total) or vector(0)",
          "legendFormat": "Low confidence",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "title": "Requêtes en Cours",
      "description": "Nombre de requêtes actuellement en cours de traitement. Utile pour détecter des pics de charge.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": "Prometheus",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sportreview_requests_in_progress or vector(0)",
          "legendFormat": "En cours",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "title": "Requêtes par Minute (par endpoint)",
      "description": "Débit de requêtes en temps réel pour chaque endpoint. Permet de voir quels endpoints sont les plus sollicités et de détecter des pics anormaux.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": "Prometheus",
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none"
          },
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(sportreview_requests_total[1m])) by (endpoint)",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 7,
      "title": "Latence par Endpoint (p50 / p95 / p99)",
      "description": "Distribution de la latence pour chaque endpoint. p50 = latence médiane, p95 = 95% des requêtes, p99 = cas extrêmes. Un écart important entre p50 et p99 indique des pics occasionnels.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": "Prometheus",
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5
          },
          "unit": "s"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(sportreview_request_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p50 {{endpoint}}",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(sportreview_request_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p95 {{endpoint}}",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(sportreview_request_latency_seconds_bucket[5m])) by (le, endpoint))",
          "legendFormat": "p99 {{endpoint}}",
          "refId": "C"
        }
      ]
    },

    {
      "id": 8,
      "title": "Distribution des Prédictions par Label",
      "description": "Répartition des labels prédits par le modèle en temps réel. Une distribution très différente de celle d'entraînement peut signaler un data drift (changement du comportement des utilisateurs).",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": "Prometheus",
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "pieType": "pie",
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(sportreview_predictions_total) by (label)",
          "legendFormat": "{{label}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 9,
      "title": "Évolution des Prédictions par Label (tendance)",
      "description": "Évolution dans le temps de la fréquence de chaque label prédit. Permet de détecter si le modèle commence à sur-prédire une classe (symptôme de drift).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 12 },
      "datasource": "Prometheus",
      "options": {
        "legend": {
          "calcs": ["mean", "last"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "POSITIF" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "NEGATIF" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "NEUTRE" },
            "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "SPAM" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(sportreview_predictions_total[5m])) by (label)",
          "legendFormat": "{{label}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "title": "Distribution du Score de Confiance",
      "description": "Histogramme des scores de confiance du modèle. Idéalement, la majorité des prédictions doit avoir une confiance > 70%. Des scores bas en masse indiquent un problème de modèle ou de données.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": "Prometheus",
      "options": {
        "legend": {
          "calcs": ["mean"],
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(sportreview_confidence_bucket[5m])) by (le))",
          "legendFormat": "Confiance médiane (p50)",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.25, sum(rate(sportreview_confidence_bucket[5m])) by (le))",
          "legendFormat": "Confiance p25 (bas)",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.75, sum(rate(sportreview_confidence_bucket[5m])) by (le))",
          "legendFormat": "Confiance p75 (haut)",
          "refId": "C"
        }
      ]
    },

    {
      "id": 11,
      "title": "Feedbacks Reçus (corrections humaines)",
      "description": "Nombre de corrections envoyées via l'endpoint /feedback. Ces données servent au Human-in-the-Loop : quand on accumule assez de corrections, on peut réentraîner le modèle avec ces nouveaux exemples annotés.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": "Prometheus",
      "options": {
        "legend": {
          "calcs": ["sum", "last"],
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "unit": "short"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(increase(sportreview_feedback_total[1m]))",
          "legendFormat": "Feedbacks / minute",
          "refId": "A"
        }
      ]
    }

  ],
  "refresh": "10s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["sportreview", "mlops", "ml-monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SportReview AI — Monitoring",
  "uid": "sportreview-ai-dashboard",
  "version": 1
}
